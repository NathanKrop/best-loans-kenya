NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://bestloans:change-me@localhost:5432/bestloans?schema=public
FRONTEND_ORIGIN=http://localhost:8000
PRIVACY_POLICY_VERSION=2026-10
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-a-different-random-secret
NATIONAL_ID_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
RESEND_API_KEY=
EMAIL_FROM=
DEV_OTP_CODE=

# M-Pesa Daraja credentials. Keep these values private and do not expose them in frontend code.
MPESA_ENV=sandbox
MPESA_APP_NAME=goldenValley
MPESA_SANDBOX_TEST_MODE=false
MPESA_SHORTCODE=3584917
MPESA_CONSUMER_KEY=replace-with-daraja-consumer-key
MPESA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
MPESA_PASSKEY=replace-with-daraja-passkey
MPESA_CALLBACK_URL=https://your-public-host.example/api/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
