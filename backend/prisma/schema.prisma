generator client {
  provider = "prisma-client-js"
}

model LoanOffer {
  id                 String          @id @default(uuid()) @db.Uuid
  applicationId      String          @unique @db.Uuid
  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approvedAmount     Int
  interestBasisPoints Int            @default(1000)
  interestAmount     Int
  repaymentAmount    Int
  termDays           Int
  status             LoanOfferStatus @default(OFFERED)
  note               String
  offeredByUserId    String          @db.Uuid
  offeredBy          User            @relation(fields: [offeredByUserId], references: [id], onDelete: Restrict)
  acceptedAt         DateTime?
  disbursedAt        DateTime?
  dueAt              DateTime?
  repaidAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  payments Payment[]
}

model LoanAuditLog {
  id                String          @id @default(uuid()) @db.Uuid
  applicationId     String          @db.Uuid
  application       LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorUserId       String          @db.Uuid
  actor             User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action            String
  note              String
  createdAt         DateTime        @default(now())

  @@index([applicationId, createdAt])
}

model Assurance {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @unique @db.Uuid
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType       AssuranceDocumentType
  nationalIdFront    String?
  nationalIdBack     String?
  passportBioPage    String?
  selfie             String?
  guarantorFullName  String
  guarantorPhone     String
  consentedAt        DateTime?
  status             AssuranceStatus       @default(DRAFT)
  submittedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

enum OtpPurpose {
  VERIFY_PHONE
  VERIFY_EMAIL
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  fullName           String
  email              String?   @unique
  phone              String?   @unique
  passwordHash       String
  consentedAt        DateTime  @default(now())
  consentPolicyVersion String  @default("2026-10")
  phoneVerifiedAt    DateTime?
  emailVerifiedAt    DateTime?
  registrationPaidAt DateTime?
  status             UserStatus @default(ACTIVE)
  payments           Payment[]
  otpCodes           OtpCode[]
  profile            Profile?
  assurance          Assurance?
  loanApplications    LoanApplication[]
  offersMade          LoanOffer[]
  auditActions        LoanAuditLog[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
}

model Profile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalIdEncrypted   String?
  nationalIdLast3       String?
  dateOfBirth           DateTime @db.Date
  county                String
  monthlyIncomeRange    String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum LoanApplicationStatus {
  PENDING
  OFFERED
  APPROVED
  REJECTED
}

enum LoanOfferStatus {
  OFFERED
  DECLINED
  DISBURSEMENT_PENDING
  DISBURSEMENT_FAILED
  ACTIVE
  REPAID
}

enum AssuranceDocumentType {
  NATIONAL_ID
  PASSPORT
}

enum AssuranceStatus {
  DRAFT
  SUBMITTED
}

model LoanApplication {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @db.Uuid
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  periodDays  Int
  purpose     String
  status      LoanApplicationStatus   @default(PENDING)
  offer       LoanOffer?
  auditLogs   LoanAuditLog[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    OtpPurpose @default(VERIFY_EMAIL)
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, createdAt])
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid
  user               User          @relation(fields: [userId], references: [id])
  loanOfferId        String?       @db.Uuid
  loanOffer          LoanOffer?    @relation(fields: [loanOfferId], references: [id], onDelete: Restrict)
  pendingKey         String?       @unique
  purpose            String        @default("REGISTRATION_FEE")
  amount             Int
  phone              String
  merchantRequestId  String?
  checkoutRequestId  String?       @unique
  mpesaReceiptNumber String?       @unique
  resultCode         Int?
  resultDesc         String?
  status             PaymentStatus @default(PENDING)
  transactionDate    DateTime?
  callbackReceivedAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId, status])
  @@index([loanOfferId, purpose, status])
  @@index([status, createdAt])
}
