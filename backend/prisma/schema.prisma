generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

enum OtpPurpose {
  VERIFY_PHONE
  VERIFY_EMAIL
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  fullName           String
  email              String?   @unique
  phone              String?   @unique
  passwordHash       String
  consentedAt        DateTime  @default(now())
  consentPolicyVersion String  @default("2026-10")
  phoneVerifiedAt    DateTime?
  emailVerifiedAt    DateTime?
  registrationPaidAt DateTime?
  status             UserStatus @default(ACTIVE)
  payments           Payment[]
  otpCodes           OtpCode[]
  profile            Profile?
  loanApplications    LoanApplication[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
}

model Profile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalIdEncrypted   String
  nationalIdLast3       String
  dateOfBirth           DateTime @db.Date
  county                String
  monthlyIncomeRange    String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum LoanApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model LoanApplication {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @db.Uuid
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  periodDays  Int
  purpose     String
  status      LoanApplicationStatus   @default(PENDING)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    OtpPurpose @default(VERIFY_EMAIL)
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, createdAt])
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid
  user               User          @relation(fields: [userId], references: [id])
  pendingKey         String?       @unique
  purpose            String        @default("REGISTRATION_FEE")
  amount             Int
  phone              String
  merchantRequestId  String?
  checkoutRequestId  String?       @unique
  mpesaReceiptNumber String?       @unique
  resultCode         Int?
  resultDesc         String?
  status             PaymentStatus @default(PENDING)
  transactionDate    DateTime?
  callbackReceivedAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}
